# --- Auto-actualización de marcadores ---
# Proveedores soportados:
#   - football-data (football-data.org): API key en https://www.football-data.org/client/register
#   - api-sports    (api-football.com):  API key en https://dashboard.api-football.com
# Déjalo vacío para usar solo los resultados del Excel.
FOOTBALL_API_KEY=

# Proveedor de datos: "football-data" o "api-sports".
FOOTBALL_PROVIDER=football-data

# Solo para football-data: código de competición (Mundial = "WC").
FOOTBALL_COMPETITION=WC

# Solo para api-sports: league=1 es FIFA World Cup, season es el año del torneo.
FOOTBALL_API_LEAGUE=1
FOOTBALL_API_SEASON=2026

# Frecuencia del refresco automático (formato cron). Por defecto cada 10 min.
POLL_CRON=*/10 * * * *

# Token opcional para cargar/corregir resultados a mano vía la API.
# Si lo dejas vacío, el endpoint de carga manual queda deshabilitado.
ADMIN_TOKEN=
