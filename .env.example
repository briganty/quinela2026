# --- Auto-actualización de marcadores ---
# Consigue una API key gratuita en https://www.football-data.org/client/register
# (proveedor por defecto). Déjalo vacío para usar solo los resultados del Excel.
FOOTBALL_API_KEY=

# Proveedor de datos. Por ahora: "football-data" (football-data.org).
FOOTBALL_PROVIDER=football-data

# Código de competición en el proveedor. En football-data.org el Mundial es "WC".
FOOTBALL_COMPETITION=WC

# Frecuencia del refresco automático (formato cron). Por defecto cada 10 min.
POLL_CRON=*/10 * * * *

# Token opcional para cargar/corregir resultados a mano vía la API.
# Si lo dejas vacío, el endpoint de carga manual queda deshabilitado.
ADMIN_TOKEN=
